# Build mode: development or production
# - development: Mount source code as volume, compile on-demand (slower but easier to develop)
# - production: Copy source code into image, pre-compile (faster runtime)
BUILD_MODE=development

# Volume mount for development mode
# Empty for production, otherwise source is mounted
VOLUME_MOUNT=

# Force rebuild (set to true for production to always rebuild)
# - false (default): Use cached build in development
# - true: Force rebuild every time (recommended for production)
FORCE_BUILD=false
